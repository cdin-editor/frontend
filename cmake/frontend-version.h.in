#ifndef CDIN_FRONTEND_CORE_VERSION_H
#define CDIN_FRONTEND_CORE_VERSION_H

/* Generated from the resolved Frontend package version (Git tag for releases). */
#define CDIN_FRONTEND_FOUNDATION_VERSION_MAJOR @PROJECT_VERSION_MAJOR@u
#define CDIN_FRONTEND_FOUNDATION_VERSION_MINOR @PROJECT_VERSION_MINOR@u
#define CDIN_FRONTEND_FOUNDATION_VERSION_PATCH @PROJECT_VERSION_PATCH@u
#define CDIN_FRONTEND_FOUNDATION_VERSION_STRING "@PROJECT_VERSION@"

/* The shared Backend/Frontend wire contract is versioned independently. */
#define CDIN_FRONTEND_FOUNDATION_PROTOCOL_MAJOR 1u
#define CDIN_FRONTEND_FOUNDATION_PROTOCOL_MINOR 0u
#define CDIN_FRONTEND_FOUNDATION_PROTOCOL_PATCH 0u

#endif
