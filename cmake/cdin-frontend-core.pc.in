prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: cdin-frontend-core
Description: UI-neutral CDIN Frontend Core
Version: @PROJECT_VERSION@
Requires.private: m-mdy-m-log >= 0.1.0
Libs: -L${libdir} -lcdin_frontend_core
Cflags: -I${includedir}
