@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(cdinFrontendCore @PROJECT_VERSION@ CONFIG REQUIRED)
if(@CDIN_FRONTEND_CONFIG_HAS_TUI@)
    find_dependency(cdinFrontendTUI @PROJECT_VERSION@ CONFIG REQUIRED)
endif()
if(@CDIN_FRONTEND_CONFIG_HAS_GUI_SDL@)
    find_dependency(cdinFrontendGUISDL @PROJECT_VERSION@ CONFIG REQUIRED)
endif()
check_required_components(cdinFrontend)
